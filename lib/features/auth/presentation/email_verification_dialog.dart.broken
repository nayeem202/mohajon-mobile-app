import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../providers/auth_providers.dart';
import '../../../core/theme/app_typography.dart';
import '../../../core/theme/mohajon_warm_theme.dart';
import 'auth_brand.dart';

/// Prompts the user for the 6-digit email verification code sent by the
/// custom auth service. Returns true when the email got verified.
Future<bool> showEmailVerificationDialog(
  BuildContext context,
  WidgetRef ref, {
  required String email,
}) async {
  final result = await showDialog<bool>(
    context: context,
    barrierDismissible: false,
    builder: (_) => _EmailVerificationDialog(email: email),
  );
  return result ?? false;
}

class _EmailVerificationDialog extends ConsumerStatefulWidget {
  const _EmailVerificationDialog({required this.email});

  final String email;

  @override
  ConsumerState<_EmailVerificationDialog> createState() =>
      _EmailVerificationDialogState();
}

class _EmailVerificationDialogState
    extends ConsumerState<_EmailVerificationDialog> {
  final _codeController = TextEditingController();
  final _codeFocus = FocusNode();
  String? _error;
  bool _notice = false;
  bool _busy = false;
  bool _success = false;

  @override
  void dispose() {
    _codeController.dispose();
    _codeFocus.dispose();
    super.dispose();
  }

  Future<void> _verify() async {
    final code = _codeController.text.trim();
    if (code.isEmpty) {
      setState(() {
        _error = 'Enter the 6-digit code';
        _notice = false;
      });
      return;
    }

    setState(() {
      _busy = true;
      _error = null;
      _notice = false;
    });

    try {
      await ref
          .read(authServiceProvider.notifier)
          .verifyEmail(email: widget.email, code: code);
      if (mounted) {
        setState(() {
          _success = true;
          _error = null;
        });
        await Future.delayed(const Duration(milliseconds: 350));
        if (mounted) Navigator.of(context).pop(true);
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _error = e.toString();
          _notice = false;
        });
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _resend() async {
    setState(() {
      _busy = true;
      _error = null;
      _notice = false;
    });
    try {
      await ref.read(authServiceProvider.notifier).sendEmailVerificationCode(
            email: widget.email,
          );
      if (mounted) {
        setState(() {
          _error = 'Code resent to ${widget.email}';
          _notice = true;
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          _error = e.toString();
          _notice = false;
        });
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final locale = Localizations.localeOf(context);
    final height = MediaQuery.sizeOf(context).height;

    return PopScope(
      canPop: _success,
      child: Dialog(
        backgroundColor: Colors.transparent,
        insetPadding: const EdgeInsets.fromLTRB(20, 24, 20, 24),
        child: ConstrainedBox(
          constraints: BoxConstraints(maxWidth: 420, maxHeight: height * 0.92),
          child: Container(
            clipBehavior: Clip.antiAlias,
            decoration: BoxDecoration(
              color: AuthBrand.panelBackground,
              borderRadius: BorderRadius.circular(30),
              boxShadow: [
                BoxShadow(
                  color: AuthBrand.buttonGlow.withValues(alpha: .22),
                  blurRadius: 40,
                  offset: const Offset(0, 18),
                ),
                BoxShadow(
                  color: AuthBrand.panelText.withValues(alpha: .10),
                  blurRadius: 6,
                  offset: const Offset(0, 2),
                ),
              ],
            ),
            child: Column(
              mainAxisSize: MainAxisSize.min,
              crossAxisAlignment: CrossAxisAlignment.stretch,
              children: [
                _Header(email: widget.email, locale: locale),
                Expanded(
                  child: SingleChildScrollView(
                    physics: const BouncingScrollPhysics(),
                    padding: const EdgeInsets.fromLTRB(24, 22, 24, 20),
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      crossAxisAlignment: CrossAxisAlignment.stretch,
                      children: [
                        Text(
                          'Enter the 6-digit code we emailed you to confirm this address and finish setting up your account.',
                          textAlign: TextAlign.center,
                          style: AppType.body(
                            const TextStyle(
                              color: AuthBrand.panelMuted,
                              fontSize: 14.5,
                              height: 1.45,
                            ),
                            locale: locale,
                          ),
                        ),
                        const SizedBox(height: 20),
                        _CodeField(
                          controller: _codeController,
                          focusNode: _codeFocus,
                          locale: locale,
                          onSubmitted: (_) => _verify(),
                        ),
                        AnimatedSize(
                          duration: const Duration(milliseconds: 180),
                          curve: Curves.easeOutCubic,
                          alignment: Alignment.topCenter,
                          child: _error == null
                              ? const SizedBox(width: double.infinity)
                              : Padding(
                                  padding: const EdgeInsets.only(top: 12),
                                  child: _StatusLine(
                                    message: _error!,
                                    isNotice: _notice,
                                    locale: locale,
                                  ),
                                ),
                        ),
                        const SizedBox(height: 20),
                        _VerifyButton(
                          busy: _busy,
                          label: 'Verify & continue',
                          onPressed: _verify,
                        ),
                        const SizedBox(height: 4),
                        Row(
                          children: [
                            Expanded(
                              child: TextButton(
                                onPressed: _busy ? null : _resend,
                                style: TextButton.styleFrom(
                                  foregroundColor: AuthBrand.primaryDeep,
                                  disabledForegroundColor: AuthBrand.panelMuted
                                      .withValues(alpha: .45),
                                ),
                                child: const Text('Resend code'),
                              ),
                            ),
                            Container(
                              height: 18,
                              width: 1,
                              color: AuthBrand.fieldBorder,
                            ),
                            Expanded(
                              child: TextButton(
                                onPressed: _busy || _success
                                    ? null
                                    : () => Navigator.of(context).pop(false),
                                style: TextButton.styleFrom(
                                  foregroundColor: AuthBrand.panelMuted,
                                  disabledForegroundColor: AuthBrand.panelMuted
                                      .withValues(alpha: .45),
                                ),
                                child: const Text('Skip for now'),
                              ),
                            ),
                          ],
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }
}