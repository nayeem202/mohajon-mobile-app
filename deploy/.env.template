# ============================================================
# Haalkhata production environment - copy to .env on server
# and replace all values with generated secrets
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=authdb
POSTGRES_USER=auth
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- JWT ---
# auth-service token signing secret (64+ chars, hex recommended)
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
# haalkhata-service's own token signing secret (distinct from JWT_SECRET)
HAALKHATA_JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX

# --- Database schema for haalkhata-service ---
DB_SCHEMA=hk

# --- App ---
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGINS=*
MAIL_PROVIDER=console

# --- JVM tuning (2 GiB RAM server) ---
AUTH_JAVA_OPTS=-Xmx256m -XX:MaxMetaspaceSize=128m -Djava.security.egd=file:/dev/./urandom
HAALKHATA_JAVA_OPTS=-Xmx384m -XX:MaxMetaspaceSize=160m -Djava.security.egd=file:/dev/./urandom
