rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsShop(shopId) {
      return signedIn()
        && shopId == 'shop_' + request.auth.uid;
    }

    function validShopWrite(shopId) {
      return ownsShop(shopId)
        && request.resource.data.shopId == shopId;
    }

    match /registrations/{userId} {
      allow read: if signedIn()
        && request.auth.uid == userId;
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.shopId == 'shop_' + userId;
      allow delete: if false;
    }

    match /pending_registrations/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId}/login_sessions/{sessionId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if ownsShop(shopId);
      allow write: if ownsShop(shopId)
        && request.resource.data.shopId == shopId;
      allow delete: if false;
    }

    match /shops/{shopId}/{collectionId}/{documentId} {
      allow create: if validShopWrite(shopId);
      allow read: if ownsShop(shopId);
      allow update, delete: if validShopWrite(shopId)
        && resource.data.shopId == shopId
        && request.resource.data.shopId == shopId;
    }
  }
}
